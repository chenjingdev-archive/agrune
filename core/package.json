{
  "name": "agrune",
  "version": "0.1.0",
  "description": "Manifest-driven browser-control CLI for AI agents — the peer of @playwright/cli, built on the Playwright public API.",
  "type": "module",
  "bin": {
    "agrune": "dist/bin/agrune.js"
  },
  "main": "./dist/src/api.js",
  "types": "./dist/src/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/api.d.ts",
      "default": "./dist/src/api.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/skill/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:no-internals": "node scripts/verify-no-internals.mjs",
    "build:manifest": "tsc -p packages/manifest/tsconfig.json",
    "prebuild": "npm run build:manifest",
    "pretypecheck": "npm run build:manifest",
    "pretest": "npm run build:manifest",
    "bench:token": "tsx bench/token-bench.ts",
    "bench:grounding": "tsx bench/grounding-eval.ts",
    "verify": "npm run verify:no-internals && npm run typecheck && npm run test"
  },
  "dependencies": {
    "playwright": "^1.59",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@agrune/manifest": "file:packages/manifest",
    "@types/node": "^20.12.0",
    "gpt-tokenizer": "^3.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "keywords": [
    "playwright",
    "cli",
    "browser",
    "automation",
    "ai-agent",
    "manifest"
  ]
}
